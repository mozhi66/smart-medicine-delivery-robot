# 默认自动检测文本/二进制
* text=auto

# 脚本与文档统一 LF，保证跨平台一致
*.py     text eol=lf
*.md     text eol=lf
*.yaml   text eol=lf
*.yml    text eol=lf
*.json   text eol=lf
*.txt    text eol=lf
.gitignore text eol=lf

# 固件源码与工程文件
*.c      text
*.h      text
*.s      text
*.uvprojx text
*.uvoptx  text

# 二进制资源
*.png    binary
*.jpg    binary
*.docx   binary
